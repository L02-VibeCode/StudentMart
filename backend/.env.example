NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Generate a random secret before starting the API; see README. Do not use this example as a secret.
# AUTH_RATE_LIMIT_SECRET=<random-secret-with-at-least-32-characters>
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/student-mart

# Cloudinary avatar provider (server only). Uncomment and fill all three in local .env.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
