{
  "expo": {
    "name": "StudentMart",
    "slug": "studentmart",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StudentMart to select a profile photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
